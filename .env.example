# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key fallback
VITE_GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# SolarEdge Site ID and API Key
SOLAREDGE_SITE_ID="YOUR_SOLAREDGE_SITE_ID"
SOLAREDGE_API_KEY="YOUR_SOLAREDGE_API_KEY"

# Calendar iCal Feeds (comma-separated URLs, enclosed in double quotes)
CALENDAR_ICAL_URLS="https://calendar.google.com/calendar/ical/.../basic.ics"

# Sonos Integration Configurations
# Configure a comma-separated list of your local Sonos speaker IP addresses:
SONOS_SPEAKER_IPS=192.168.1.40,192.168.1.41
# The Sonos Favorite name to play at 20:00:
SONOS_FAVORITE_NAME=Home

# Solar Forecast Rule Configurations
# Note: Location (latitude/longitude), Array Peak Capacity (kWp), and Battery Size
# are automatically queried directly from the SolarEdge API (details & inventory).
# The variables below are optional overrides/thresholds if needed:
SOLAR_TILT_DEG=35
SOLAR_AZIMUTH_DEG=0
SOLAR_PERFORMANCE_RATIO=0.8
SOLAR_CHARGE_THRESHOLD_KWH=8.2
SOLAR_BATTERY_FULL_SKIP_PCT=90
# Optional overrides for location/capacity if SolarEdge details API is unavailable:
# SOLAR_LAT=53.4808
# SOLAR_LON=-2.2426
# SOLAR_ARRAY_KWP=9.3
# SOLAR_BATTERY_USABLE_KWH=10.3

